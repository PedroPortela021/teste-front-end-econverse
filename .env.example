# Opcional. Se vazio:
# - em dev: usa /api/products.json (proxy do Vite → Econverse, sem CORS no browser)
# - em build: usa a URL HTTPS direta (precisa de CORS na API, ou configure proxy no host)
# VITE_PRODUCTS_API_URL=https://app.econverse.com.br/teste-front-end/junior/tecnologia/lista-produtos/produtos.json

# Docker (produção):
#   docker compose up --build  → http://localhost:8080
#   O Dockerfile define VITE_PRODUCTS_API_URL=/api/products.json; o Nginx repassa para a Econverse.
# Docker (dev com hot reload):
#   docker compose --profile dev up dev  → http://localhost:5173

# URL pública do deploy (sem barra final). Melhora canonical, Open Graph e gera dist/sitemap.xml no build.
# VITE_SITE_URL=https://seu-dominio.com.br
